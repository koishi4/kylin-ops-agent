# 复制为 .env 并填写。不要把真实 key 提交到 git。

# 大模型切换：deepseek（云端，国产开源，开发/演示默认） 或 mock（离线确定性桩，无网/CI）
LLM_PROVIDER=deepseek

# DeepSeek 云端（OpenAI 兼容）。如私有化自托管，把 DEEPSEEK_BASE_URL 指向自己的 OpenAI 兼容网关即可。
DEEPSEEK_API_KEY=sk-你的key
DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# 审计库
AUDIT_DB=./audit.sqlite
# 审计哈希链密钥（防篡改）：生产经密钥库注入，此默认值仅供开发演示。
AUDIT_HMAC_KEY=kylin-ops-agent-audit-chain-v1

# 执行账户（最小权限，非 root）。以 root 运行时 kill/clean 变更动作经沙箱 setuid 降权到该账户；
# 该账户不存在则无法降权、变更命令会以 root 落地（动作 trace 的 privilege_posture 会如实标注）。
EXEC_USER=opsagent
# 以 root 运行时是否拒绝启动：默认 false（仅告警，避免误伤官方虚机 root 演示）；隔离/生产置 true。
REFUSE_ROOT=false
# 强制最小权限落地（赛题需求④）。默认 false（demo 顺滑，仅在动作 trace 标注落地身份）；
# 置 true → fail-closed：任何会以 root 落地的变更动作（未降权/降权账户不存在/进程内以 root 跑）直接拒绝。
REQUIRE_PRIVILEGE_DROP=false

# ---- 受控动作鉴权（P0-4，最小版，刻意不做 RBAC）----
# 留空 = 演示模式：本机可信控制台不强制鉴权（配合下方只监听 127.0.0.1）。
# 生产/联网演示务必改强随机串；前端用 frontend/.env 的 VITE_OPERATOR_TOKEN 设同值。
OPERATOR_TOKEN=please-change-me
# 后端默认只监听本机回环（python -m app.main 生效）。对外暴露须显式改并务必配 OPERATOR_TOKEN。
# 失败安全启动守卫（P0-D）：API_BIND_HOST 非回环（联网/生产）时，若 OPERATOR_TOKEN 为空
# 或 AUDIT_HMAC_KEY 仍是默认值 → 后端拒绝启动。本机 demo（127.0.0.1）不受影响。
API_BIND_HOST=127.0.0.1

# ---- MCP 工具投毒处置（P0-C）----
# 可疑工具默认 fail-closed 不进 LLM 上下文：high 无条件隔离；medium 默认隔离。
# 置 true = operator override：medium 降为「需人工复核」放行（high 仍隔离）。演示默认 false。
QUARANTINE_ALLOW_MEDIUM=false
# 工具 schema 指纹基线文件（P2 rug-pull 检测）：首次扫描通过即 TOFU 锚定，之后工具 description/schema
# 被悄改→指纹变→自动隔离。合法升级经 POST /guardrail/tool-scan/pin 重锚。文件已在 .gitignore。
TOOL_BASELINE_PATH=./tool_baseline.json

# ---- 执行沙箱（护栏放行后真正落地命令的资源/权限保险丝，P4-3）----
SANDBOX_ENABLED=true
SANDBOX_CPU_SECONDS=5
SANDBOX_MEM_MB=256
SANDBOX_MAX_PROCS=64
SANDBOX_FSIZE_MB=16
